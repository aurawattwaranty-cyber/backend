# --- server ---
PORT=4000
# Comma-separated list of allowed frontend origins.
# `SITE_URL` is also accepted automatically as a CORS origin.
CORS_ORIGIN=http://localhost:3000
SITE_URL=http://localhost:3000

# --- database ---
# Leave MONGODB_URI empty to fall back to a local JSON store (development only).
MONGODB_URI=
DATABASE_NAME=aurawatt
# Leave disabled except for an intentional local test reset.
ALLOW_DATA_RESET=false

# --- media ---
# Required for photo uploads. Registration cannot be completed without these.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=aurawatt

# --- auth ---
# Long, random signing secret. Generate with: openssl rand -base64 48
JWT_SECRET=KIjegNaIPcCvEyedGVg7mHHGeOp0upYHjN7aiJnvMTmSVZ/biG3XsjEWLDKs78qs
COOKIE_NAME=aw_access

JWT_ACCESS_TTL_DAYS=7
JWT_REMEMBER_TTL_DAYS=30

# Bootstrap admin account. Applied ONCE, when the database has no admin
# accounts — changing these later has no effect on an existing account.
# Leave ADMIN_PASSWORD empty and the server generates a strong one and prints
# it to the console on first boot. Change it after first login via
# POST /api/auth/password.
ADMIN_EMAIL=admin@aurawatt.in
ADMIN_NAME=Aurawatt Admin
ADMIN_PASSWORD=
