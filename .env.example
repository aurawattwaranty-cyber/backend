# --- server ---
PORT=4000
CORS_ORIGIN=http://localhost:3000
SITE_URL=http://localhost:3000

# --- database ---
# Leave MONGODB_URI empty to fall back to a local JSON store (development only).
MONGODB_URI=
DATABASE_NAME=aurawatt

# --- media ---
# Required for photo uploads. Registration cannot be completed without these.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=aurawatt

# --- auth ---
COOKIE_NAME=aw_session

# Bootstrap admin account. Applied ONCE, when the database has no admin
# accounts — changing these later has no effect on an existing account.
# Leave ADMIN_PASSWORD empty and the server generates a strong one and prints
# it to the console on first boot. Change it after first login via
# POST /api/auth/password.
ADMIN_EMAIL=admin@aurawatt.in
ADMIN_NAME=Aurawatt Admin
ADMIN_PASSWORD=
